@page "/projects/{projectId:long}/testsuites"
@model TestManagement.APP.Pages.Project.TestSuites.IndexModel
@{
    ViewData["Title"] = "TestSuite管理";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">TestSuite管理</h1>
        <a asp-page="/Project/Index" asp-route-id="@Model.Project?.Id" class="btn btn-outline-secondary">ダッシュボードへ戻る</a>
    </div>
    @if (Model.TestSuites.Any())
    {
        <div class="row g-3">
            @foreach (var testSuite in Model.TestSuites)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm"><div class="card-body">
                        <h2 class="h5">@testSuite.Name</h2>
                        <p class="text-muted mb-0" style="white-space: pre-line;">@testSuite.Description</p>
                    </div></div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">このプロジェクトに割り当てられたTestSuiteはありません。</div>
    }
</div>
