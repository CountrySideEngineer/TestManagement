@page "/projects"
@model TestManagement.APP.Pages.Project.IndexModel
@{
    ViewData["Title"] = Model.Project?.Name ?? "プロジェクト";
}

<div class="container">
    <div class="block">
        @if (Model.Project is not null)
        {
            <div class="block-title">@Model.Project.Name</div>

            <div class="card">
                <div class="card-body">
                    <h1 class="h3 card-title">@Model.Project.Name</h1>
                    <p class="card-text" style="white-space: pre-line;">@Model.Project.Description</p>
                </div>
            </div>

            <div class="mt-3">
                <a asp-page="/Index" class="btn btn-secondary">プロジェクト一覧へ戻る</a>
            </div>
        }
    </div>
</div>
