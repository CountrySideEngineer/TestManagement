@page "/projects/{projectId:long}/executions/create"
@model TestManagement.APP.Pages.Project.Executions.CreateModel
@{
    ViewData["Title"] = "テスト実行追加";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">テスト実行追加</h1>
        <a asp-page="/Project/Executions/Index"
           asp-route-projectId="@RouteData.Values["projectId"]"
           class="btn btn-outline-secondary">
            実行履歴へ戻る
        </a>
    </div>

    <form method="post">
        <div class="mb-3">
            <label asp-for="ExecutedAt" class="form-label">実行日</label>
            <input asp-for="ExecutedAt" class="form-control" type="datetime-local" />
            <span asp-validation-for="ExecutedAt" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Environment" class="form-label">実行環境</label>
            <select asp-for="Environment" class="form-select">
                @foreach (var environment in Model.Environments)
                {
                    <option value="@environment.Name">@environment.DisplayName</option>
                }
            </select>
            <span asp-validation-for="Environment" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Revision" class="form-label">リビジョン</label>
            <input asp-for="Revision" class="form-control" />
            <span asp-validation-for="Revision" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">登録</button>
        <a asp-page="/Project/Executions/Index"
           asp-route-projectId="@RouteData.Values["projectId"]"
           class="btn btn-secondary">
            キャンセル
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
