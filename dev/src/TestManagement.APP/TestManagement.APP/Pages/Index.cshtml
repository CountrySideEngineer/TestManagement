@page
@model IndexModel
@{
    ViewData["Title"] = "プロジェクト一覧";
}

<div class="container">
    <div class="block">
        <div class="block-title">プロジェクト一覧</div>
        <div class="project-list">
            @if (Model.Projects.Any())
            {
                <div class="row g-3">
                    @foreach (var project in Model.Projects)
                    {
                        <div class="col-12 col-md-6">
                            <a asp-page="/Projects/Index"
                               asp-route-id="@project.Id"
                               class="card h-100 text-decoration-none">
                                <div class="card-body">
                                    <h2 class="card-title h5">@project.Name</h2>
                                    <p class="card-text">@project.Description</p>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="muted" style="padding:8px 0;">プロジェクトがありません。</div>
            }
        </div>
    </div>
</div>
