@page
@model IndexModel
@{
    ViewData["Title"] = "プロジェクト一覧";

    string GetDescriptionPreview(string description)
    {
        return description.Length > 24
            ? $"{description[..23]}..."
            : description;
    }
}

<style>
    .project-list-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, 280px);
        gap: 1rem;
        justify-content: start;
    }
</style>

<div class="container">
    <div class="block">
        <div class="block-title">プロジェクト一覧</div>
        <div class="mb-3">
            <a asp-page="/Project/Create"
               class="btn btn-primary"
               title="プロジェクトを追加"
               aria-label="プロジェクトを追加">プロジェクトを追加</a>
        </div>
        <div class="project-list">
            @if (Model.Projects.Any())
            {
                <div class="project-list-grid">
                    @foreach (var project in Model.Projects)
                    {
                        <div>
                            <a asp-page="/Projects/Index"
                               asp-route-id="@project.Id"
                               class="card h-100 text-decoration-none">
                                <div class="card-body">
                                    <h2 class="card-title">@project.Name</h2>
                                    <p class="card-text small" style="white-space: pre-line;">@GetDescriptionPreview(project.Description)</p>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="muted" style="padding:8px 0;">プロジェクトがありません。</div>
            }
        </div>
    </div>
</div>
